<Window x:Class="JLVoice.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JL Voice" Width="650" Height="430" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource BodyFont}" UseLayoutRounding="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="JL Voice" Margin="24,0" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,4,8,4">
        <Button x:Name="MinimizeButton" Content="−" Width="38" Padding="0" AutomationProperties.Name="Minimize" Click="MinimizeClick"/>
        <Button x:Name="CloseButton" Content="×" Width="38" Padding="0" AutomationProperties.Name="Close to tray" Click="CloseClick"/>
      </StackPanel>
      <Grid Grid.Row="1" Margin="30,10,30,24">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <Image x:Name="Orbit" Width="23" Height="23" Margin="0,3,16,0" VerticalAlignment="Top"/>
          <TextBlock Text="JL Voice" FontFamily="{DynamicResource DisplayFont}" FontWeight="Light" FontSize="26"/>
        </StackPanel>
        <Button x:Name="NavigationButton" Width="110" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top" Click="NavigateClick"/>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,0">
          <Grid>
            <StackPanel x:Name="Overview">
              <TextBlock x:Name="StatusText" MaxHeight="64" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource DisplayFont}" FontSize="24" FontWeight="Light" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
              <StackPanel x:Name="NoticePanel" Visibility="Collapsed" Margin="0,0,0,18">
                <TextBlock x:Name="NoticeBody" FontSize="14" Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                <Expander x:Name="NoticeDetails" Foreground="{DynamicResource DimBrush}">
                  <TextBlock x:Name="NoticeDetailsText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </Expander>
              </StackPanel>
              <TextBlock x:Name="ShortcutText" FontFamily="{DynamicResource MonoFont}" FontSize="20" Margin="0,0,0,16"/>
              <TextBlock x:Name="InstructionText" Style="{StaticResource Muted}"/>
              <TextBlock x:Name="LanguageSummary" Style="{StaticResource Muted}" Margin="0,5,0,22"/>
              <Button x:Name="BackToWorkButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="BackToWorkClick" Margin="0,0,0,24"/>
              <TextBlock x:Name="EmptyResultText" Style="{StaticResource Muted}"/>
              <StackPanel x:Name="LastResult" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,8">
                  <Button x:Name="ClearButton" DockPanel.Dock="Right" Click="ClearClick"/>
                  <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="CopyClick"/>
                  <TextBlock x:Name="ResultHeading" FontSize="18" FontFamily="{DynamicResource DisplayFont}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" MaxHeight="210" VerticalScrollBarVisibility="Auto" TextChanged="ResultChanged"/>
              </StackPanel>
              <TextBlock x:Name="PrivacyText" Style="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0"/>
            </StackPanel>
            <StackPanel x:Name="Preferences" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Continue">
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="LanguageLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="DictationLanguage" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="MicrophoneLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/>
                  <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="10,7" Click="RefreshClick"/><ComboBox x:Name="Microphone" AutomationProperties.LabeledBy="{Binding ElementName=MicrophoneLabel}"/></DockPanel>
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="KeyLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="ShortcutKey" AutomationProperties.LabeledBy="{Binding ElementName=KeyLabel}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <CheckBox x:Name="PushToTalk" Grid.Column="2" VerticalAlignment="Bottom"/>
              </Grid>
              <TextBlock x:Name="ShortcutHelp" Style="{StaticResource Muted}" Margin="0,8,0,10"/>
              <CheckBox x:Name="IdleBubble" Margin="0,6,0,24"/>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="ThemeLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="Theme" SelectionChanged="AppearanceChanged" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="UiLanguageLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="UiLanguage" SelectionChanged="InterfaceChanged" AutomationProperties.LabeledBy="{Binding ElementName=UiLanguageLabel}"/></StackPanel>
              </Grid>
              <Expander x:Name="Advanced" Foreground="{DynamicResource DimBrush}" Margin="0,8,0,10">
                <StackPanel Margin="0,14,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="ModelLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="Model" AutomationProperties.LabeledBy="{Binding ElementName=ModelLabel}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock x:Name="ThreadsLabel" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="Threads" AutomationProperties.LabeledBy="{Binding ElementName=ThreadsLabel}"/></StackPanel>
                  </Grid>
                  <TextBlock x:Name="ModelHelp" Style="{StaticResource Muted}" Margin="0,9,0,0"/>
                  <CheckBox x:Name="ReviewAudio" Margin="0,14,0,0"/>
                </StackPanel>
              </Expander>
              <DockPanel Margin="0,18,0,0">
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="SaveClick"/>
                <TextBlock x:Name="PendingText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
